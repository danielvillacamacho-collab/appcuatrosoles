{
  "name": "polo-platform",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate:dev": "pnpm --filter @polo/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @polo/api exec tsx prisma/seed.ts",
    "check:isolation": "pnpm --filter @polo/api run check:isolation",
    "check:arch": "depcruise --config .dependency-cruiser.cjs apps/*/src packages/*/src"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "dependency-cruiser": "^16.4.0",
    "prettier": "^3.3.0",
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "typescript-eslint": "^8.11.0"
  }
}
