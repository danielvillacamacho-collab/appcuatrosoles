// Fuente única del esquema (docs/01-architecture.md §1). Los modelos se agregan tarea por
// tarea siguiendo specs/010-identidad-acceso-roles/tasks.md y el detalle de su plan.md §1.
//
// Convenciones obligatorias (docs/02-domain-model.md, memory/constitution.md):
//   - `id` = UUID v7, ordenable por tiempo → `@default(uuid(7))`.
//   - Todo timestamp se persiste `timestamptz` en UTC (P-08) → `@db.Timestamptz(3)`.
//     Ojo: el default de Prisma para `DateTime` es `timestamp(3)` SIN zona; hay que ser
//     explícito en cada campo o se viola el principio en silencio.
//   - Tablas y columnas en snake_case (`@@map`/`@map`), porque el SQL crudo de las
//     migraciones (T-004, T-005) y los reportes referencian los nombres así.
//   - Dinero en `BigInt` de centavos, sufijo `_cents` (P-02). Handicap en `Int` de medios
//     goles, sufijo `_halves` (P-03). Ninguno de los dos aparece todavía en este módulo.

generator client {
  provider = "prisma-client-js"
  // Sin `output` explícito a propósito: con pnpm, `@prisma/client` está enlazado al store
  // central, así que el cliente generado tiene que escribirse junto a él (allí lo busca en
  // runtime). Fijar una ruta propia lo rompe. La consecuencia es que el CLI debe correr con
  // el directorio de trabajo en `apps/api`; ver los scripts `db:*` de la raíz.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── T-001 · Identidad: persona, cuenta y sesión ────────────────────────────────
// docs/02-domain-model.md §B · specs/010-identidad-acceso-roles/plan.md §1

/// El individuo real. Existe aunque no tenga acceso a la plataforma: un invitado externo
/// a una copa, o un menor de edad bajo la cuenta de su acudiente, son `person` sin
/// `user_account` (HU-010-03, HU-010-10).
model Person {
  id        String    @id @default(uuid(7))
  clubId    String    @map("club_id")
  fullName  String    @map("full_name")
  phone     String?
  /// Informativo y de contacto. El correo de *acceso* vive en `UserAccount.email`; no son
  /// el mismo dato y no tienen por qué coincidir.
  email     String?
  birthdate DateTime? @db.Date

  photoKey String?      @map("photo_key")
  isMinor  Boolean      @default(false) @map("is_minor")
  status   PersonStatus @default(active)
  notes    String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id")

  userAccount       UserAccount?
  organizations     PersonOrganization[]
  membershipHistory MembershipAssignment[]

  /// Cuentas familiares: una misma persona puede ser acudiente de varios menores y, a la
  /// vez, estar a cargo de alguien (`guardianship`, HU-010-10).
  guardianOf  Guardianship[] @relation("Guardian")
  dependentOf Guardianship[] @relation("Dependent")

  /// Exenciones de responsabilidad: las que aceptó esta persona, y las que aceptó *en nombre
  /// de* otra (un acudiente firmando por su hijo menor).
  waiverAcceptances       WaiverAcceptance[] @relation("WaiverSubject")
  waiversAcceptedOnBehalf WaiverAcceptance[] @relation("WaiverAcceptedBy")

  /// T-202: la llave foránea que 010 dejó anotada como deuda. Ver `specs/020` §T-202.
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([clubId, email])
  @@index([clubId, status])
  @@map("person")
}

/// Nada se borra: se archiva (constitution P-06).
enum PersonStatus {
  active
  archived

  @@map("person_status")
}

/// El acceso de una persona a la plataforma.
/// Invariante R-010-01: una persona tiene como máximo una cuenta (`personId` único).
model UserAccount {
  id       String @id @default(uuid(7))
  personId String @unique @map("person_id")

  /// Correo de acceso, único en toda la plataforma (no por club). Una persona = un correo
  /// = un solo acceso, incluso si opera en varios clubes: el club se resuelve por
  /// subdominio y la sesión lleva un «club activo» explícito (ADR-013, specs/140
  /// HU-140-03 — nuestro personal atiende varios clubes sin manejar credenciales
  /// distintas). Ver el riesgo R-1 de plan.md §7.
  email        String @unique
  /// Argon2id (docs/06-security-privacy.md §2). Nunca texto legible, nunca reversible.
  passwordHash String @map("password_hash")

  status UserAccountStatus @default(invited)

  /// Correo nuevo, a la espera de que su titular lo confirme (T-042, HU-010-07).
  ///
  /// Vive aparte de `email` a propósito: **el correo anterior sigue siendo válido hasta que se
  /// confirme el nuevo** (`docs/06` §2). Si se cambiara `email` de una y la confirmación no
  /// llegara —dedo, buzón lleno, correo mal escrito— la persona quedaría sin poder entrar y sin
  /// forma de recuperarlo, porque el restablecimiento iría a la dirección equivocada.
  pendingEmail String? @map("pending_email")

  /// Bloqueo por intentos fallidos: 5 intentos → 15 minutos (T-032, configurable en
  /// `docs/08-configuration-catalog.md` §9).
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)

  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person   Person    @relation(fields: [personId], references: [id])
  sessions Session[]

  /// Los roles se asignan a la CUENTA, no a la persona: una persona sin acceso no tiene
  /// permisos que ejercer (plan.md §1, nota final).
  roleAssignments RoleAssignment[] @relation("AccountRoles")

  // Rastro de quién otorgó y quién revocó cada rol, y de las delegaciones de comisario.
  // Son punteros de auditoría con llave foránea real: un `granted_by_id` que apunte a una
  // cuenta inexistente haría inútil el registro justo cuando se necesita (R-010-11).
  rolesGranted         RoleAssignment[]         @relation("RolesGranted")
  rolesRevoked         RoleAssignment[]         @relation("RolesRevoked")
  delegationsGiven     CommissionerDelegation[] @relation("DelegationsGiven")
  delegationsReceived  CommissionerDelegation[] @relation("DelegationsReceived")
  membershipsAssigned  MembershipAssignment[]   @relation("MembershipsAssigned")
  auditEntries         AuditLog[]               @relation("AuditActor")
  auditEntriesOnBehalf AuditLog[]               @relation("AuditOnBehalfOf")

  settingsCreated         Setting[]
  oneTimeTokens           OneTimeToken[]
  notificationPreferences NotificationPreference[]
  fieldBookingsCreated    FieldBooking[]

  @@map("user_account")
}

/// Estados y transiciones en spec.md HU-010-04 y §6 R-010-06. Sólo `active` puede iniciar
/// sesión; la regla vive en `packages/domain/identity/accountStatusAllowsLogin` (T-010).
enum UserAccountStatus {
  invited
  active
  suspended
  archived

  @@map("user_account_status")
}

/// Sesión de servidor con cookie opaca, no JWT (ADR-005): el documento exige poder revocar
/// una sesión ya emitida — ver dispositivos activos, cerrar todas, y que suspender una
/// cuenta corte el acceso de inmediato (R-010-09, T-056).
model Session {
  id            String @id @default(uuid(7))
  userAccountId String @map("user_account_id")

  /// Se guarda el hash del token, no el token. Si la base de datos se filtra, las sesiones
  /// activas no son secuestrables.
  tokenHash String  @unique @map("token_hash")
  userAgent String? @map("user_agent")
  /// IP hasheada: sirve para «inicio de sesión desde un dispositivo nuevo» sin almacenar
  /// el dato personal en claro (docs/06 §8).
  ipHash    String? @map("ip_hash")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  rememberMe Boolean   @default(false) @map("remember_me")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id])

  @@index([userAccountId, revokedAt])
  @@map("session")
}

// ─── T-002 · Organizaciones, roles y delegación ─────────────────────────────────
// docs/02-domain-model.md §B · specs/010-identidad-acceso-roles/plan.md §1

/// Vínculo de una persona con una organización que opera dentro del club (hoy, Cuatro
/// Soles). Se guarda historia (`leftOn`) en vez de un campo mutable: alguien puede salir y
/// volver, y el club necesita poder responder «desde cuándo era estudiante» (P-06).
model PersonOrganization {
  id String @id @default(uuid(7))

  /// P-05: toda tabla de negocio lleva `club_id`, aunque `organizationId` ya lo implique.
  /// Denormalizado a propósito, para que el filtro de tenant de la capa de repositorio sea
  /// uniforme en TODAS las tablas — sin un join distinto por tabla ni una lista de
  /// excepciones que alguien tenga que recordar.
  clubId String @map("club_id")

  personId       String          @map("person_id")
  /// Todavía sin llave foránea: la tabla `organization` la crea el módulo 020. Ver la nota
  /// «Integridad pendiente» al final de este archivo.
  organizationId String          @map("organization_id")
  relationship   OrgRelationship

  /// Fechas de calendario, no instantes: el día en que entró o salió de la organización.
  joinedOn DateTime  @map("joined_on") @db.Date
  leftOn   DateTime? @map("left_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id])

  /// T-202: la llave foránea que 010 dejó anotada como deuda. Ver `specs/020` §T-202.
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  /// T-202: idem para la organización. Ya no puede apuntar a una que no existe.
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([clubId, organizationId, relationship])
  @@index([personId])
  @@map("person_organization")
}

enum OrgRelationship {
  student
  client
  team_member
  staff

  @@map("org_relationship")
}

/// Un rol otorgado a una cuenta, con su alcance. Los permisos son acumulativos y nunca
/// restrictivos entre sí (R-010-03): no existe un rol que quite lo que otro concede, así
/// que evaluar permisos es unir los de todas las asignaciones vigentes.
model RoleAssignment {
  id            String   @id @default(uuid(7))
  userAccountId String   @map("user_account_id")
  role          RoleName

  /// Esta tabla es la **única excepción deliberada a P-05**, y conviene entender por qué:
  /// `scope` + `scopeId` ya *son* la frontera de tenant (scope=club → `scopeId` es el club;
  /// scope=organization → es la organización), y un `superadmin` tiene scope=platform,
  /// donde no existe club alguno. Un `club_id` paralelo sería una segunda fuente de verdad
  /// que puede contradecir a `scopeId` — peor que no tenerlo.
  scope   ScopeKind
  /// Nulo únicamente cuando `scope = platform`, que no cuelga de ninguna entidad.
  scopeId String?   @map("scope_id")

  /// `grantedAt` cumple el papel de `created_at` de esta tabla; no se duplica.
  grantedById String    @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedById String?   @map("revoked_by_id")
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  userAccount UserAccount  @relation("AccountRoles", fields: [userAccountId], references: [id])
  grantedBy   UserAccount  @relation("RolesGranted", fields: [grantedById], references: [id])
  /// `onDelete: Restrict` explícito: el default de Prisma para una relación opcional es
  /// `SET NULL`, que borraría en silencio **quién revocó el rol** — precisamente el dato que
  /// la auditoría existe para conservar (P-07). Si algún día el flujo de datos personales
  /// (Ley 1581) necesita eliminar la cuenta, que falle y obligue a decidir explícitamente
  /// cómo anonimizar, en vez de perder el rastro sin que nadie se entere.
  revokedBy   UserAccount? @relation("RolesRevoked", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userAccountId, revokedAt])
  @@index([scope, scopeId])
  @@map("role_assignment")
}

/// `player` es el rol base de toda cuenta activa; los demás se suman encima
/// (docs/02 §B, spec.md §4).
enum RoleName {
  superadmin
  club_admin
  organization_admin
  commissioner
  instructor
  groom
  treasurer
  player

  @@map("role_name")
}

enum ScopeKind {
  platform
  club
  organization

  @@map("scope_kind")
}

/// El comisario puede enfermarse, viajar o estar jugando, y la operación deportiva no puede
/// quedar bloqueada: delega temporalmente su autoridad en un subcomisario. Toda acción hecha
/// bajo delegación se audita con `on_behalf_of_id`, nunca como si la hubiera hecho el
/// comisario en persona (docs/02 §B, R-010-11).
model CommissionerDelegation {
  id String @id @default(uuid(7))

  /// El rol de comisario es de alcance de club, así que la delegación siempre pertenece a
  /// un club concreto (P-05).
  clubId String @map("club_id")

  delegatorId String @map("delegator_id")
  delegateId  String @map("delegate_id")

  /// La delegación siempre tiene inicio y fin: una autoridad delegada «hasta nuevo aviso»
  /// es justamente lo que R-010 quiere evitar.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// Acotada a una temporada o a un torneo. `scopeId` apunta a esa temporada o torneo, cuyas
  /// tablas llegan en los módulos 020 y 060.
  scope   DelegationScope
  scopeId String?         @map("scope_id")

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  delegator UserAccount @relation("DelegationsGiven", fields: [delegatorId], references: [id])
  delegate  UserAccount @relation("DelegationsReceived", fields: [delegateId], references: [id])

  /// T-202: la llave foránea que 010 dejó anotada como deuda. Ver `specs/020` §T-202.
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@index([clubId, delegateId, revokedAt])
  @@map("commissioner_delegation")
}

enum DelegationScope {
  season
  tournament

  @@map("delegation_scope")
}

// ─── T-003 · Membresías y cuentas familiares ────────────────────────────────────
// docs/02-domain-model.md §A y §B · specs/010-identidad-acceso-roles/plan.md §1

/// Categoría de membresía del club: estudiante, miembro temporal, miembro permanente, socio,
/// invitado. Es un **catálogo administrable**, no un enum de código: el club puede crear o
/// retirar categorías sin que nadie despliegue nada (P-04, PRD §16 «todo administrable»).
/// Por eso `code` es texto y no un tipo cerrado.
model MembershipCategory {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  /// Identificador estable para que el código pueda referirse a una categoría sin depender
  /// del nombre visible: `student`, `temporary_member`, `permanent_member`, `partner`,
  /// `guest`… El club puede añadir otros.
  code String
  name String

  /// **Primer campo de dinero del proyecto.** `BigInt` de centavos de peso colombiano, nunca
  /// decimal ni punto flotante (P-02): `0.1 + 0.2 !== 0.3` en punto flotante, y un error de
  /// redondeo aquí es plata real de una persona real. El sufijo `_cents` es obligatorio para
  /// que la unidad sea imposible de confundir al leer el código.
  ///
  /// Es el valor **vigente**, no un histórico: los importes ya cobrados quedan congelados en
  /// `charge.amount_cents` (módulo 100), así que cambiar esta cuota no reescribe el pasado.
  monthlyFeeCents BigInt @map("monthly_fee_cents")

  /// Derechos de la categoría, administrables sin desplegar (P-04). Claves esperadas:
  /// `puede_postular_practicas`, `puede_inscribir_copas`, `requiere_aptitud`,
  /// `puede_reservar_taqueo`. Es `jsonb` porque el club puede añadir derechos que hoy no
  /// existen; la forma la valida el dominio, no la base.
  rights Json

  /// Se desactiva, no se borra (P-06): una categoría retirada sigue apareciendo en el
  /// historial de quien la tuvo.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments MembershipAssignment[]

  /// T-202: la llave foránea que 010 dejó anotada como deuda. Ver `specs/020` §T-202.
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([clubId, code])
  @@index([clubId, active])
  @@map("membership_category")
}

/// Qué categoría tuvo cada persona y desde cuándo. Es **historial**, no un campo mutable en
/// `person`: el club necesita poder responder «con qué categoría jugaba en marzo» sin
/// adivinar, y las tarifas cobradas dependen de eso (PRD §2).
model MembershipAssignment {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  personId             String @map("person_id")
  membershipCategoryId String @map("membership_category_id")

  /// Fechas de calendario, no instantes: un cambio de categoría «aplica desde el siguiente
  /// ciclo de facturación» (PRD §2), que es un día, no un momento del día.
  /// `effectiveTo` nulo = vigente hoy.
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  assignedById String   @map("assigned_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  person     Person             @relation(fields: [personId], references: [id])
  category   MembershipCategory @relation(fields: [membershipCategoryId], references: [id])
  assignedBy UserAccount        @relation("MembershipsAssigned", fields: [assignedById], references: [id])

  /// T-202: la llave foránea que 010 dejó anotada como deuda. Ver `specs/020` §T-202.
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@index([clubId, personId, effectiveFrom])
  @@index([membershipCategoryId])
  @@map("membership_assignment")
}

/// Un adulto a cargo de un perfil de menor. El menor es una `person` completa —con su
/// caballada, su bolsa de clases y su handicap— pero **sin cuenta de usuario**: no inicia
/// sesión. El acudiente reserva, paga y firma en su nombre (PRD §3, HU-010-10).
model Guardianship {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  guardianPersonId  String @map("guardian_person_id")
  dependentPersonId String @map("dependent_person_id")

  /// Un menor puede tener dos acudientes (padre y madre), pero **uno solo** es el pagador
  /// principal: en su estado de cuenta se consolidan los cobros del menor (R-010-10).
  /// La base garantiza «como máximo uno vigente»; que haya «al menos uno» lo vigila el job
  /// diario de integridad (T-071), porque depende de la fecha y no cabe en un constraint.
  isPrimaryPayer Boolean @default(false) @map("is_primary_payer")

  startsOn DateTime  @map("starts_on") @db.Date
  endsOn   DateTime? @map("ends_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  guardian  Person @relation("Guardian", fields: [guardianPersonId], references: [id])
  dependent Person @relation("Dependent", fields: [dependentPersonId], references: [id])

  /// T-202: la llave foránea que 010 dejó anotada como deuda. Ver `specs/020` §T-202.
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@index([clubId, dependentPersonId])
  @@index([guardianPersonId])
  @@map("guardianship")
}

// ─── T-004 · Exenciones de responsabilidad y auditoría ──────────────────────────
// docs/02-domain-model.md §B · specs/010-identidad-acceso-roles/plan.md §1

/// Versión publicada del texto de exención de responsabilidad (waiver). Cada versión se
/// conserva íntegra y para siempre: si en 2029 alguien discute qué aceptó en 2026, la
/// respuesta es el texto exacto de esa versión, no el vigente (PRD §2).
model WaiverVersion {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  /// Correlativo por club. El vigente es el de mayor `version` ya publicado.
  version Int
  /// El texto completo, no una referencia a un archivo que pueda cambiar o perderse.
  body    String

  publishedAt DateTime @map("published_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  acceptances WaiverAcceptance[]

  /// T-202: la llave foránea que 010 dejó anotada como deuda. Ver `specs/020` §T-202.
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([clubId, version])
  @@index([clubId, publishedAt])
  @@map("waiver_version")
}

/// Constancia de que una persona aceptó una versión concreta del waiver. Es evidencia legal:
/// guarda quién aceptó, en nombre de quién, cuándo y desde qué IP (hasheada).
///
/// R-010-12: sin aceptación vigente de la última versión publicada no se puede postular a una
/// práctica ni reservar una clase. Para un menor, acepta su acudiente — por eso
/// `acceptedByPersonId` puede ser distinto de `personId` (PRD §2, HU-010-11).
model WaiverAcceptance {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  /// La persona a la que cubre la exención (puede ser un menor sin cuenta).
  personId           String @map("person_id")
  /// Quién la aceptó materialmente: la propia persona, o su acudiente si es menor.
  acceptedByPersonId String @map("accepted_by_person_id")
  waiverVersionId    String @map("waiver_version_id")

  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  /// IP hasheada, no en claro: sirve como evidencia de la aceptación sin almacenar un dato
  /// personal innecesario (docs/06 §8).
  ipHash     String?  @map("ip_hash")

  person     Person        @relation("WaiverSubject", fields: [personId], references: [id])
  acceptedBy Person        @relation("WaiverAcceptedBy", fields: [acceptedByPersonId], references: [id])
  version    WaiverVersion @relation(fields: [waiverVersionId], references: [id])

  /// Una persona acepta una versión una sola vez; aceptarla dos veces no significa nada.
  /// T-202: la llave foránea que 010 dejó anotada como deuda. Ver `specs/020` §T-202.
  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([personId, waiverVersionId])
  @@index([clubId, personId])
  @@map("waiver_acceptance")
}

/// Registro de auditoría. **Append-only** (P-07): sólo INSERT y SELECT.
///
/// La garantía no es una convención del código de servicio — está en la base de datos, con
/// triggers que rechazan UPDATE, DELETE y TRUNCATE (ver la migración de esta tarea). El
/// propósito de una auditoría que se puede editar es cero: esta tabla es la que resuelve
/// «¿quién cambió este handicap?» meses después, y su valor depende enteramente de que nadie
/// —ni un administrador, ni el superusuario de la base— haya podido tocarla.
model AuditLog {
  id String @id @default(uuid(7))

  /// Nulo sólo en acciones de alcance de plataforma, que no cuelgan de ningún club (por
  /// ejemplo, crear un club). La capa de repositorio debe tratar el NULL explícitamente:
  /// esas filas sólo las ve un superadministrador.
  clubId String? @map("club_id")

  /// Nulo cuando la acción la ejecutó el sistema y no una persona (un job programado, una
  /// reconciliación). Distinguirlo importa: «nadie» y «no sabemos quién» no son lo mismo.
  actorUserId  String? @map("actor_user_id")
  /// Presente cuando se actuó **por delegación**: el subcomisario que firma con la autoridad
  /// del comisario queda registrado como tal, nunca como si fuera el comisario en persona
  /// (docs/02 §B, R-010-11).
  onBehalfOfId String? @map("on_behalf_of_id")

  action     String
  entityType String @map("entity_type")
  /// Referencia polimórfica a propósito: la auditoría cubre cualquier entidad del sistema, así
  /// que no puede tener llave foránea. Debe sobrevivir aunque la entidad ya no exista.
  entityId   String @map("entity_id")

  before Json?
  after  Json?

  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// El mismo identificador que viaja en la respuesta de error de la API y en los logs de
  /// Pino (docs/03 §2): es el hilo que conecta el reclamo de un usuario con lo que pasó.
  requestId  String   @map("request_id")

  actor      UserAccount? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  onBehalfOf UserAccount? @relation("AuditOnBehalfOf", fields: [onBehalfOfId], references: [id], onDelete: Restrict)

  // No hay `updated_at`: esta tabla no se actualiza nunca.
  /// T-202: sí lleva llave foránea, aunque la tabla sea append-only. Agregar la restricción
  /// es un ALTER que **lee** las filas para validarlas; los triggers de P-07 bloquean UPDATE,
  /// DELETE y TRUNCATE, no la validación. Ver el razonamiento completo en `verification.md`.
  club Club? @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@index([clubId, entityType, entityId])
  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_log")
}

// ─── T-201 · Club, organizaciones, temporadas y configuración ───────────────────
// docs/02-domain-model.md §A · specs/020-club-configuracion/plan.md §1

/// La raíz del tenant. Todo dato de negocio pertenece a un club, y el club se resuelve por el
/// **subdominio del host** (ADR-013, R-020-01): un `club_id` que llegue del cliente nunca lo
/// determina. Es la frontera de seguridad número uno del producto (`docs/09` D-01).
model Club {
  id String @id @default(uuid(7))

  /// Subdominio, único en toda la plataforma. Minúsculas y `[a-z0-9-]`, garantizado por CHECK en
  /// la migración: un slug con mayúsculas o un punto rompería la resolución por host **en
  /// silencio**, sirviendo el club equivocado o ninguno.
  slug String @unique
  name String

  /// Identificador IANA. Define qué día es «hoy» para toda regla de calendario (R-020-13). No se
  /// asume `America/Bogota` en ningún punto del código: el producto se vende a otros clubes y uno
  /// en Buenos Aires no puede depender de que alguien recuerde cambiar una constante.
  timezone String @default("America/Bogota")
  /// ISO 4217. Informativa en v1: se opera en una sola moneda y el dinero se persiste en centavos
  /// enteros (P-02, R-020-14).
  currency String @default("COP")

  status          ClubStatus @default(active)
  /// Cuándo y por qué se suspendió. Se conserva tras reactivar: la historia de un corte de
  /// servicio es justo lo que se necesita cuando hay una discusión contractual.
  suspendedAt     DateTime?  @map("suspended_at") @db.Timestamptz(3)
  suspendedReason String?    @map("suspended_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizations Organization[]
  seasons       Season[]

  // T-202 · Todo lo que cuelga del club, ahora con integridad referencial de verdad.
  people                  Person[]
  peopleOrganizations     PersonOrganization[]
  commissionerDelegations CommissionerDelegation[]
  membershipCategories    MembershipCategory[]
  membershipAssignments   MembershipAssignment[]
  guardianships           Guardianship[]
  waiverVersions          WaiverVersion[]
  waiverAcceptances       WaiverAcceptance[]
  auditEntries            AuditLog[]
  fields                  Field[]
  fieldBookings           FieldBooking[]

  @@index([status])
  @@map("club")
}

enum ClubStatus {
  active
  suspended

  @@map("club_status")
}

/// Una entidad que opera **dentro** de un club: la escuela, un equipo, un servicio. Hoy: Cuatro
/// Soles dentro de Los Pinos.
///
/// Pertenece a exactamente un club (R-020-05, decisión D-020-01 del spec). Si la misma marca opera
/// en otro club, allá es **otra** organización, con su propia gente y sus propias tarifas: una
/// organización que cruzara clubes sería un camino de datos entre inquilinos, que es justo lo que
/// P-05 existe para impedir.
model Organization {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  name String
  /// `school` | `team` | `service` (`docs/02` §A). Texto y no enum, como `membership_category.code`:
  /// es un catálogo administrable y el club puede necesitar un tipo que hoy no existe (P-04).
  type String

  status     OrganizationStatus @default(active)
  archivedAt DateTime?          @map("archived_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  club    Club                 @relation(fields: [clubId], references: [id], onDelete: Restrict)
  members PersonOrganization[]

  @@unique([clubId, name])
  @@index([clubId, status])
  @@map("organization")
}

enum OrganizationStatus {
  active
  archived

  @@map("organization_status")
}

/// El período al que pertenece la actividad: prácticas, copas, handicaps y estadísticas se agrupan
/// por temporada (`docs/02` §A, HU-020-06).
model Season {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  name String

  /// Fechas de calendario, no instantes: una temporada empieza un día, no a una hora. Mismo
  /// criterio que `guardianship` — y la misma trampa evitada, porque comparar una columna `date`
  /// contra un instante da por vencido lo que aún rige (ver `verification.md` de 010, §T-014).
  startsOn DateTime @map("starts_on") @db.Date
  /// Último día de la temporada, **inclusive**. Lo hace explícito el `EXCLUDE` de la migración,
  /// que usa un rango cerrado `[]`.
  endsOn   DateTime @map("ends_on") @db.Date

  status   SeasonStatus @default(open)
  closedAt DateTime?    @map("closed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([clubId, name])
  @@index([clubId, startsOn])
  @@map("season")
}

enum SeasonStatus {
  open
  closed

  @@map("season_status")
}

/// Un valor de configuración vigente desde una fecha (`docs/02` §A, `docs/08`).
///
/// **Nunca se actualiza en sitio** (R-020-08): cambiar un valor inserta una fila nueva, y el
/// vigente es el de mayor `effective_from` menor o igual al instante consultado. Así una tarifa
/// histórica sigue siendo consultable, que es lo que permite responder «cuánto costaba esto en
/// marzo» sin preguntarle a nadie.
///
/// La **clave** no vive aquí sino en el catálogo tipado de `packages/domain/settings` (T-212,
/// `plan.md` §0): agregar una clave es siempre un cambio de código, porque alguien tiene que
/// leerla, y una clave sin código que la consuma es configuración que no aplica nada.
model Setting {
  id String @id @default(uuid(7))

  /// Igual que en `role_assignment`: `scope` + `scope_id` **son** la frontera, y por eso esta
  /// tabla tampoco lleva `club_id` aparte. Un ámbito de plataforma no cuelga de ningún club.
  scope   ScopeKind
  /// Nulo exactamente cuando `scope = platform`, garantizado por CHECK en la migración.
  scopeId String?   @map("scope_id")

  key   String
  value Json

  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(3)
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Sin `updatedAt`: esta tabla no se actualiza nunca, se le agregan filas.
  /// Quién fijó el valor. Nulo cuando lo puso el sistema (el arranque, una migración).
  createdBy UserAccount? @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([scope, scopeId, key, effectiveFrom])
  @@index([scope, scopeId, key, effectiveFrom])
  @@map("setting")
}

// ─── T-035/T-036 · Enlaces de un solo uso ───────────────────────────────────────
// specs/010-identidad-acceso-roles/spec.md R-010-08, R-010-09 · docs/06 §2

/// Un enlace de un solo uso: la invitación para definir la primera contraseña, o el
/// restablecimiento cuando alguien la olvida.
///
/// Los dos son el mismo objeto con distinta duración y distinto correo, así que comparten tabla:
/// separarlos habría duplicado la lógica de vigencia y la de un solo uso, que es exactamente la
/// que no conviene tener dos veces.
model OneTimeToken {
  id            String @id @default(uuid(7))
  userAccountId String @map("user_account_id")

  type OneTimeTokenType

  /// Igual que en `session`: se guarda el hash, nunca el token. Si la base se filtra, ningún
  /// enlace pendiente es utilizable.
  tokenHash String @unique @map("token_hash")

  /// Desde cuándo cuenta la ventana de validez.
  sentAt DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  /// Cuándo se usó. De un solo uso (R-010-08): con esto puesto, el enlace ya no sirve.
  usedAt DateTime? @map("used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Restrict)

  @@index([userAccountId, type, usedAt])
  @@map("one_time_token")
}

enum OneTimeTokenType {
  invitation
  password_reset
  email_change

  @@map("one_time_token_type")
}

// ─── T-091 · Preferencias de notificación ───────────────────────────────────────

/// Qué avisos **no críticos** quiere recibir una persona.
///
/// Es una lista de exclusiones, no de inclusiones: sin fila, se recibe. Al revés —tener que
/// activar cada aviso— la gente se queda sin enterarse de nada y culpa a la plataforma.
///
/// **Los avisos de seguridad no se pueden apagar** (`docs/06`, `notifications.security_always_sent`):
/// «tu contraseña cambió» o «tu cuenta fue suspendida» son la única señal que recibe alguien a
/// quien le pasó algo que no pidió. La regla vive en `packages/domain` y esta tabla no la puede
/// contradecir.
model NotificationPreference {
  id            String @id @default(uuid(7))
  userAccountId String @map("user_account_id")

  /// El tipo de aviso, con los mismos nombres que la bandeja de salida (`plan.md` §5).
  type    String
  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Restrict)

  @@unique([userAccountId, type])
  @@map("notification_preference")
}

// ─── T-026 · Bandeja de salida transaccional ────────────────────────────────────
// memory/constitution.md P-11 · specs/010-identidad-acceso-roles/plan.md §5

/// Un mensaje pendiente de enviar (correo, notificación), encolado **en la misma transacción** que
/// el cambio de datos que lo origina (P-11).
///
/// Por qué una tabla y no encolar directo en la cola de trabajos: `pg-boss` (ADR-012) abre su
/// propia conexión, así que un `send()` suyo no participa de la transacción de Prisma. Si el
/// cambio se revierte después de encolar, sale un correo por algo que nunca ocurrió; si el proceso
/// muere entre el `COMMIT` y el `send()`, la invitación no llega nunca y nadie se entera. Con una
/// fila en la misma transacción, las dos cosas son imposibles: o pasan juntas o no pasa ninguna.
model OutboxMessage {
  id String @id @default(uuid(7))

  /// Nulo en mensajes de ámbito de plataforma. Sirve para depurar y para poder purgar por club.
  clubId String? @map("club_id")

  /// Qué hay que hacer: `identity.send-invitation`, `identity.send-password-reset`… Los nombres
  /// son los de `plan.md` §5.
  type    String
  payload Json

  /// Desde cuándo se puede procesar. Permite reintentos con espera y envíos programados.
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// El índice que usa el procesador: pendientes que ya se pueden enviar, en orden de llegada.
  @@index([sentAt, availableAt])
  @@map("outbox_message")
}

// ─── Integridad pendiente (no es un olvido) ─────────────────────────────────────
// `person.club_id`, `person_organization.club_id` / `.organization_id` y
// `commissioner_delegation.club_id` son todavía TEXT sin llave foránea, porque las tablas
// `club` y `organization` las crea el **módulo 020** (el siguiente, misma Fase 1 del
// roadmap). Cuando existan, 020 debe agregar una migración que ponga esas llaves foráneas:
// hasta entonces nada impide una fila con un `club_id` que no corresponde a ningún club, y
// eso toca directamente P-05. Está anotado como entregable de 020, no como algo opcional.

// ─── T-401 · Canchas y calendario ───────────────────────────────────────────────
// specs/040-canchas/plan.md §1 · docs/02-domain-model.md §D

enum FieldStatus {
  active
  maintenance
  archived
}

/// Una cancha del club.
model Field {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  name          String
  surface       String?
  capacityNotes String? @map("capacity_notes")

  status FieldStatus @default(active)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  club     Club           @relation(fields: [clubId], references: [id], onDelete: Restrict)
  bookings FieldBooking[]

  /// Dos canchas del mismo club no se llaman igual: «¿reservaste la Cancha 2?» tiene que tener una
  /// sola respuesta posible.
  @@unique([clubId, name])
  @@index([clubId, status])
  @@map("field")
}

/// Qué ocupa la cancha. El vocabulario es del dominio y no de lo que esté implementado esta
/// semana: `stick_and_ball` existe aunque los taqueos sean de Fase 3 (`spec.md` §3).
enum BookingType {
  practice
  lesson
  tournament_match
  stick_and_ball
  coaching
  maintenance
  block
}

enum BookingVisibility {
  public
  private
}

/// **La tabla central antidoble-reserva.** Toda ocupación de una cancha pasa por aquí (R-040-01).
///
/// Si cada módulo llevara su propia agenda, la garantía de no solapamiento tendría que
/// reimplementarse en cada uno — y con eso desaparecería.
model FieldBooking {
  id      String @id @default(uuid(7))
  clubId  String @map("club_id")
  fieldId String @map("field_id")

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// Columna **generada** en la migración: `tstzrange(starts_at, ends_at, '[)')`.
  ///
  /// Prisma no sabe leer un `tstzrange` y no hace falta que lo lea: existe para que la restricción
  /// de exclusión tenga sobre qué operar. Se declara `Unsupported` para que `migrate` no intente
  /// borrarla en la siguiente migración, y **no se puede escribir** — PostgreSQL rechaza cualquier
  /// intento, así que no existe forma de guardar un rango incoherente con sus propios extremos.
  timeRange Unsupported("tstzrange")? @map("time_range")

  type       BookingType
  visibility BookingVisibility @default(public)

  /// El evento que originó la reserva: la práctica, la clase, la copa. Nulo en un bloqueo
  /// administrativo, que no tiene otro evento detrás — es el evento.
  sourceId String? @map("source_id")

  /// Por qué se bloqueó. Sólo tiene sentido en `maintenance` y `block`.
  reason String?

  createdById String    @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  club      Club        @relation(fields: [clubId], references: [id], onDelete: Restrict)
  field     Field       @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  createdBy UserAccount @relation(fields: [createdById], references: [id])

  /// El calendario de un día es siempre «este club, este rango»: sin este índice es un recorrido
  /// completo de una tabla que crece con cada práctica del año.
  @@index([clubId, startsAt])
  @@index([fieldId, startsAt])
  @@map("field_booking")
}
