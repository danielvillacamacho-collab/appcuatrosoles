// Fuente única del esquema (docs/01-architecture.md §1). Los modelos se agregan tarea por
// tarea siguiendo specs/010-identidad-acceso-roles/tasks.md y el detalle de su plan.md §1.
//
// Convenciones obligatorias (docs/02-domain-model.md, memory/constitution.md):
//   - `id` = UUID v7, ordenable por tiempo → `@default(uuid(7))`.
//   - Todo timestamp se persiste `timestamptz` en UTC (P-08) → `@db.Timestamptz(3)`.
//     Ojo: el default de Prisma para `DateTime` es `timestamp(3)` SIN zona; hay que ser
//     explícito en cada campo o se viola el principio en silencio.
//   - Tablas y columnas en snake_case (`@@map`/`@map`), porque el SQL crudo de las
//     migraciones (T-004, T-005) y los reportes referencian los nombres así.
//   - Dinero en `BigInt` de centavos, sufijo `_cents` (P-02). Handicap en `Int` de medios
//     goles, sufijo `_halves` (P-03). Ninguno de los dos aparece todavía en este módulo.

generator client {
  provider = "prisma-client-js"
  // Sin `output` explícito a propósito: con pnpm, `@prisma/client` está enlazado al store
  // central, así que el cliente generado tiene que escribirse junto a él (allí lo busca en
  // runtime). Fijar una ruta propia lo rompe. La consecuencia es que el CLI debe correr con
  // el directorio de trabajo en `apps/api`; ver los scripts `db:*` de la raíz.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── T-001 · Identidad: persona, cuenta y sesión ────────────────────────────────
// docs/02-domain-model.md §B · specs/010-identidad-acceso-roles/plan.md §1

/// El individuo real. Existe aunque no tenga acceso a la plataforma: un invitado externo
/// a una copa, o un menor de edad bajo la cuenta de su acudiente, son `person` sin
/// `user_account` (HU-010-03, HU-010-10).
model Person {
  id        String    @id @default(uuid(7))
  clubId    String    @map("club_id")
  fullName  String    @map("full_name")
  phone     String?
  /// Informativo y de contacto. El correo de *acceso* vive en `UserAccount.email`; no son
  /// el mismo dato y no tienen por qué coincidir.
  email     String?
  birthdate DateTime? @db.Date

  photoKey String?      @map("photo_key")
  isMinor  Boolean      @default(false) @map("is_minor")
  status   PersonStatus @default(active)
  notes    String?

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById String?  @map("created_by_id")

  userAccount       UserAccount?
  organizations     PersonOrganization[]
  membershipHistory MembershipAssignment[]

  /// Cuentas familiares: una misma persona puede ser acudiente de varios menores y, a la
  /// vez, estar a cargo de alguien (`guardianship`, HU-010-10).
  guardianOf  Guardianship[] @relation("Guardian")
  dependentOf Guardianship[] @relation("Dependent")

  // Las relaciones hacia waivers se agregan en T-004, cuando exista ese modelo.

  @@unique([clubId, email])
  @@index([clubId, status])
  @@map("person")
}

/// Nada se borra: se archiva (constitution P-06).
enum PersonStatus {
  active
  archived

  @@map("person_status")
}

/// El acceso de una persona a la plataforma.
/// Invariante R-010-01: una persona tiene como máximo una cuenta (`personId` único).
model UserAccount {
  id       String @id @default(uuid(7))
  personId String @unique @map("person_id")

  /// Correo de acceso, único en toda la plataforma (no por club). Una persona = un correo
  /// = un solo acceso, incluso si opera en varios clubes: el club se resuelve por
  /// subdominio y la sesión lleva un «club activo» explícito (ADR-013, specs/140
  /// HU-140-03 — nuestro personal atiende varios clubes sin manejar credenciales
  /// distintas). Ver el riesgo R-1 de plan.md §7.
  email        String @unique
  /// Argon2id (docs/06-security-privacy.md §2). Nunca texto legible, nunca reversible.
  passwordHash String @map("password_hash")

  status UserAccountStatus @default(invited)

  /// Bloqueo por intentos fallidos: 5 intentos → 15 minutos (T-032, configurable en
  /// `docs/08-configuration-catalog.md` §9).
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)

  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person   Person    @relation(fields: [personId], references: [id])
  sessions Session[]

  /// Los roles se asignan a la CUENTA, no a la persona: una persona sin acceso no tiene
  /// permisos que ejercer (plan.md §1, nota final).
  roleAssignments RoleAssignment[] @relation("AccountRoles")

  // Rastro de quién otorgó y quién revocó cada rol, y de las delegaciones de comisario.
  // Son punteros de auditoría con llave foránea real: un `granted_by_id` que apunte a una
  // cuenta inexistente haría inútil el registro justo cuando se necesita (R-010-11).
  rolesGranted        RoleAssignment[]         @relation("RolesGranted")
  rolesRevoked        RoleAssignment[]         @relation("RolesRevoked")
  delegationsGiven    CommissionerDelegation[] @relation("DelegationsGiven")
  delegationsReceived CommissionerDelegation[] @relation("DelegationsReceived")
  membershipsAssigned MembershipAssignment[]   @relation("MembershipsAssigned")

  @@map("user_account")
}

/// Estados y transiciones en spec.md HU-010-04 y §6 R-010-06. Sólo `active` puede iniciar
/// sesión; la regla vive en `packages/domain/identity/accountStatusAllowsLogin` (T-010).
enum UserAccountStatus {
  invited
  active
  suspended
  archived

  @@map("user_account_status")
}

/// Sesión de servidor con cookie opaca, no JWT (ADR-005): el documento exige poder revocar
/// una sesión ya emitida — ver dispositivos activos, cerrar todas, y que suspender una
/// cuenta corte el acceso de inmediato (R-010-09, T-056).
model Session {
  id            String @id @default(uuid(7))
  userAccountId String @map("user_account_id")

  /// Se guarda el hash del token, no el token. Si la base de datos se filtra, las sesiones
  /// activas no son secuestrables.
  tokenHash String  @unique @map("token_hash")
  userAgent String? @map("user_agent")
  /// IP hasheada: sirve para «inicio de sesión desde un dispositivo nuevo» sin almacenar
  /// el dato personal en claro (docs/06 §8).
  ipHash    String? @map("ip_hash")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  rememberMe Boolean   @default(false) @map("remember_me")

  userAccount UserAccount @relation(fields: [userAccountId], references: [id])

  @@index([userAccountId, revokedAt])
  @@map("session")
}

// ─── T-002 · Organizaciones, roles y delegación ─────────────────────────────────
// docs/02-domain-model.md §B · specs/010-identidad-acceso-roles/plan.md §1

/// Vínculo de una persona con una organización que opera dentro del club (hoy, Cuatro
/// Soles). Se guarda historia (`leftOn`) en vez de un campo mutable: alguien puede salir y
/// volver, y el club necesita poder responder «desde cuándo era estudiante» (P-06).
model PersonOrganization {
  id String @id @default(uuid(7))

  /// P-05: toda tabla de negocio lleva `club_id`, aunque `organizationId` ya lo implique.
  /// Denormalizado a propósito, para que el filtro de tenant de la capa de repositorio sea
  /// uniforme en TODAS las tablas — sin un join distinto por tabla ni una lista de
  /// excepciones que alguien tenga que recordar.
  clubId String @map("club_id")

  personId String @map("person_id")
  /// Todavía sin llave foránea: la tabla `organization` la crea el módulo 020. Ver la nota
  /// «Integridad pendiente» al final de este archivo.
  organizationId String          @map("organization_id")
  relationship   OrgRelationship

  /// Fechas de calendario, no instantes: el día en que entró o salió de la organización.
  joinedOn DateTime  @map("joined_on") @db.Date
  leftOn   DateTime? @map("left_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  person Person @relation(fields: [personId], references: [id])

  @@index([clubId, organizationId, relationship])
  @@index([personId])
  @@map("person_organization")
}

enum OrgRelationship {
  student
  client
  team_member
  staff

  @@map("org_relationship")
}

/// Un rol otorgado a una cuenta, con su alcance. Los permisos son acumulativos y nunca
/// restrictivos entre sí (R-010-03): no existe un rol que quite lo que otro concede, así
/// que evaluar permisos es unir los de todas las asignaciones vigentes.
model RoleAssignment {
  id            String   @id @default(uuid(7))
  userAccountId String   @map("user_account_id")
  role          RoleName

  /// Esta tabla es la **única excepción deliberada a P-05**, y conviene entender por qué:
  /// `scope` + `scopeId` ya *son* la frontera de tenant (scope=club → `scopeId` es el club;
  /// scope=organization → es la organización), y un `superadmin` tiene scope=platform,
  /// donde no existe club alguno. Un `club_id` paralelo sería una segunda fuente de verdad
  /// que puede contradecir a `scopeId` — peor que no tenerlo.
  scope ScopeKind
  /// Nulo únicamente cuando `scope = platform`, que no cuelga de ninguna entidad.
  scopeId String? @map("scope_id")

  /// `grantedAt` cumple el papel de `created_at` de esta tabla; no se duplica.
  grantedById String    @map("granted_by_id")
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedById String?   @map("revoked_by_id")
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  userAccount UserAccount @relation("AccountRoles", fields: [userAccountId], references: [id])
  grantedBy   UserAccount @relation("RolesGranted", fields: [grantedById], references: [id])
  /// `onDelete: Restrict` explícito: el default de Prisma para una relación opcional es
  /// `SET NULL`, que borraría en silencio **quién revocó el rol** — precisamente el dato que
  /// la auditoría existe para conservar (P-07). Si algún día el flujo de datos personales
  /// (Ley 1581) necesita eliminar la cuenta, que falle y obligue a decidir explícitamente
  /// cómo anonimizar, en vez de perder el rastro sin que nadie se entere.
  revokedBy UserAccount? @relation("RolesRevoked", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userAccountId, revokedAt])
  @@index([scope, scopeId])
  @@map("role_assignment")
}

/// `player` es el rol base de toda cuenta activa; los demás se suman encima
/// (docs/02 §B, spec.md §4).
enum RoleName {
  superadmin
  club_admin
  organization_admin
  commissioner
  instructor
  groom
  treasurer
  player

  @@map("role_name")
}

enum ScopeKind {
  platform
  club
  organization

  @@map("scope_kind")
}

/// El comisario puede enfermarse, viajar o estar jugando, y la operación deportiva no puede
/// quedar bloqueada: delega temporalmente su autoridad en un subcomisario. Toda acción hecha
/// bajo delegación se audita con `on_behalf_of_id`, nunca como si la hubiera hecho el
/// comisario en persona (docs/02 §B, R-010-11).
model CommissionerDelegation {
  id String @id @default(uuid(7))

  /// El rol de comisario es de alcance de club, así que la delegación siempre pertenece a
  /// un club concreto (P-05).
  clubId String @map("club_id")

  delegatorId String @map("delegator_id")
  delegateId  String @map("delegate_id")

  /// La delegación siempre tiene inicio y fin: una autoridad delegada «hasta nuevo aviso»
  /// es justamente lo que R-010 quiere evitar.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  /// Acotada a una temporada o a un torneo. `scopeId` apunta a esa temporada o torneo, cuyas
  /// tablas llegan en los módulos 020 y 060.
  scope   DelegationScope
  scopeId String?         @map("scope_id")

  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  delegator UserAccount @relation("DelegationsGiven", fields: [delegatorId], references: [id])
  delegate  UserAccount @relation("DelegationsReceived", fields: [delegateId], references: [id])

  @@index([clubId, delegateId, revokedAt])
  @@map("commissioner_delegation")
}

enum DelegationScope {
  season
  tournament

  @@map("delegation_scope")
}

// ─── T-003 · Membresías y cuentas familiares ────────────────────────────────────
// docs/02-domain-model.md §A y §B · specs/010-identidad-acceso-roles/plan.md §1

/// Categoría de membresía del club: estudiante, miembro temporal, miembro permanente, socio,
/// invitado. Es un **catálogo administrable**, no un enum de código: el club puede crear o
/// retirar categorías sin que nadie despliegue nada (P-04, PRD §16 «todo administrable»).
/// Por eso `code` es texto y no un tipo cerrado.
model MembershipCategory {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  /// Identificador estable para que el código pueda referirse a una categoría sin depender
  /// del nombre visible: `student`, `temporary_member`, `permanent_member`, `partner`,
  /// `guest`… El club puede añadir otros.
  code String
  name String

  /// **Primer campo de dinero del proyecto.** `BigInt` de centavos de peso colombiano, nunca
  /// decimal ni punto flotante (P-02): `0.1 + 0.2 !== 0.3` en punto flotante, y un error de
  /// redondeo aquí es plata real de una persona real. El sufijo `_cents` es obligatorio para
  /// que la unidad sea imposible de confundir al leer el código.
  ///
  /// Es el valor **vigente**, no un histórico: los importes ya cobrados quedan congelados en
  /// `charge.amount_cents` (módulo 100), así que cambiar esta cuota no reescribe el pasado.
  monthlyFeeCents BigInt @map("monthly_fee_cents")

  /// Derechos de la categoría, administrables sin desplegar (P-04). Claves esperadas:
  /// `puede_postular_practicas`, `puede_inscribir_copas`, `requiere_aptitud`,
  /// `puede_reservar_taqueo`. Es `jsonb` porque el club puede añadir derechos que hoy no
  /// existen; la forma la valida el dominio, no la base.
  rights Json

  /// Se desactiva, no se borra (P-06): una categoría retirada sigue apareciendo en el
  /// historial de quien la tuvo.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments MembershipAssignment[]

  @@unique([clubId, code])
  @@index([clubId, active])
  @@map("membership_category")
}

/// Qué categoría tuvo cada persona y desde cuándo. Es **historial**, no un campo mutable en
/// `person`: el club necesita poder responder «con qué categoría jugaba en marzo» sin
/// adivinar, y las tarifas cobradas dependen de eso (PRD §2).
model MembershipAssignment {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  personId             String @map("person_id")
  membershipCategoryId String @map("membership_category_id")

  /// Fechas de calendario, no instantes: un cambio de categoría «aplica desde el siguiente
  /// ciclo de facturación» (PRD §2), que es un día, no un momento del día.
  /// `effectiveTo` nulo = vigente hoy.
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  assignedById String   @map("assigned_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  person     Person             @relation(fields: [personId], references: [id])
  category   MembershipCategory @relation(fields: [membershipCategoryId], references: [id])
  assignedBy UserAccount        @relation("MembershipsAssigned", fields: [assignedById], references: [id])

  @@index([clubId, personId, effectiveFrom])
  @@index([membershipCategoryId])
  @@map("membership_assignment")
}

/// Un adulto a cargo de un perfil de menor. El menor es una `person` completa —con su
/// caballada, su bolsa de clases y su handicap— pero **sin cuenta de usuario**: no inicia
/// sesión. El acudiente reserva, paga y firma en su nombre (PRD §3, HU-010-10).
model Guardianship {
  id     String @id @default(uuid(7))
  clubId String @map("club_id")

  guardianPersonId  String @map("guardian_person_id")
  dependentPersonId String @map("dependent_person_id")

  /// Un menor puede tener dos acudientes (padre y madre), pero **uno solo** es el pagador
  /// principal: en su estado de cuenta se consolidan los cobros del menor (R-010-10).
  /// La base garantiza «como máximo uno vigente»; que haya «al menos uno» lo vigila el job
  /// diario de integridad (T-071), porque depende de la fecha y no cabe en un constraint.
  isPrimaryPayer Boolean @default(false) @map("is_primary_payer")

  startsOn DateTime  @map("starts_on") @db.Date
  endsOn   DateTime? @map("ends_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  guardian  Person @relation("Guardian", fields: [guardianPersonId], references: [id])
  dependent Person @relation("Dependent", fields: [dependentPersonId], references: [id])

  @@index([clubId, dependentPersonId])
  @@index([guardianPersonId])
  @@map("guardianship")
}

// ─── Integridad pendiente (no es un olvido) ─────────────────────────────────────
// `person.club_id`, `person_organization.club_id` / `.organization_id` y
// `commissioner_delegation.club_id` son todavía TEXT sin llave foránea, porque las tablas
// `club` y `organization` las crea el **módulo 020** (el siguiente, misma Fase 1 del
// roadmap). Cuando existan, 020 debe agregar una migración que ponga esas llaves foráneas:
// hasta entonces nada impide una fila con un `club_id` que no corresponde a ningún club, y
// eso toca directamente P-05. Está anotado como entregable de 020, no como algo opcional.
