# Copiar a .env y llenar con valores reales. Nunca se commitea el .env real
# (docs/10-operating-manual-solo.md §8, docs/07-deployment-ec2.md §4).

# En desarrollo alcanza con el dueño. **En el servidor no**: ahí esta variable apunta al rol
# `polo_app`, que no puede crear tablas ni editar la auditoría (T-007, `docs/07` §4).
#   DATABASE_URL=postgresql://polo_app:LA_CLAVE@postgres:5432/polo_dev
DATABASE_URL=postgresql://polo:polo@localhost:5432/polo_dev

# --- El rol de aplicación de menor privilegio (sólo en el servidor) -----------
#
# Dos conexiones distintas a la misma base, y la separación es el punto:
#   · DATABASE_URL        → el API. No puede DDL ni tocar audit_log / handicap_history.
#   · DATABASE_URL_ADMIN  → las migraciones. Es el dueño de las tablas.
#
# Sin DATABASE_URL_ADMIN, el despliegue usa DATABASE_URL para migrar: así una instancia que
# todavía no hizo el cambio sigue funcionando igual.
#
# APP_DB_PASSWORD es la clave de `polo_app`. La migración crea el rol SIN clave y SIN LOGIN
# —una clave en una migración es una clave en el repositorio—; el despliegue se la pone.
DATABASE_URL_ADMIN=
APP_DB_PASSWORD=

# Dominio de la instalación. El club de cada solicitud se resuelve recortando el subdominio
# contra este valor (ADR-013): con `localhost`, se entra por `club-demo.localhost:5173`.
# En producción es el dominio real, y equivocarlo hace que ningún club resuelva.
BASE_DOMAIN=localhost

# Secreto del token de CSRF (doble envío firmado, docs/06 §1). En producción es obligatorio y
# debe ser aleatorio: `openssl rand -hex 32`.
CSRF_SECRET=secreto-de-desarrollo-no-usar-en-produccion

# Dónde escribe los correos el adaptador local (T-026). Se abren en el navegador; es lo que
# permite probar invitaciones y restablecimientos sin depender de AWS SES (ADR-008).
MAIL_DIR=./.correos
SESSION_SECRET=cambia-esto-en-desarrollo-tambien
PORT=3000
# Puerto de la aplicación web, sólo en desarrollo: los enlaces de los correos apuntan al navegador
# (Vite, 5173) y no al API. En producción NO se define — la web va en el 443 detrás del proxy.
WEB_PORT=5173

# Pendiente Q-02b (docs/09-open-questions.md) — el desarrollo arranca contra FakeGateway
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# ── Correo (ADR-008) ────────────────────────────────────────────────────────────
# Cómo se envía el correo. Hay que elegir, y en producción es obligatorio:
#   ses  → Amazon SES de verdad. Exige MAIL_FROM.
#   file → se escribe a disco en MAIL_DIR. Para local y para los tests.
# Si se omite con NODE_ENV=production, la aplicación NO arranca — a propósito. Omitirla fue lo que
# hizo que el primer despliegue no enviara ninguna invitación sin que nada avisara.
MAILER=file

# Dirección desde la que se envía. Debe pertenecer al dominio verificado en SES: la política de IAM
# de la instancia sólo permite enviar desde ahí.
MAIL_FROM=

# NO hay SES_ACCESS_KEY_ID ni SES_SECRET_ACCESS_KEY, y no es un olvido: en la EC2 el SDK toma las
# credenciales del rol de la instancia (infra/terraform/iam.tf le concede ses:SendEmail restringido
# al dominio). Llaves de larga vida en un archivo hay que rotarlas, se filtran en un log y
# sobreviven a la instancia que las necesitaba.
AWS_REGION=us-east-1

SENTRY_DSN=

# Igual que SES: el bucket se accede con el rol de la instancia, no con llaves.
S3_BUCKET=

# --- Respaldo diario de la base (sólo en el servidor) -------------------------
# El nombre del bucket lo da `terraform output bucket_de_respaldos`. Lo lee el
# temporizador `respaldo-db.timer`, que corre `infra/backup-db.sh` a las 08:20 UTC.
# Sin esta variable el respaldo falla ruidosamente, que es lo que se quiere: un
# respaldo que no corre y no avisa es peor que no tenerlo.
BUCKET_DE_RESPALDOS=

# --- Interruptores de los trabajos de fondo (opcionales) -----------------------
# Normalmente NO se definen: los dos temporizadores arrancan solos con el API.
# Ponerlos en "off" apaga el trabajo de fondo correspondiente sin apagar el API, que
# es lo que se quiere durante una migración de datos o para aislar un incidente.
#   OUTBOX_SCHEDULER=off     → deja de mandar los correos encolados (no los pierde)
#   DECISION_SCHEDULER=off   → deja de decidir prácticas a su hora (no las pierde)

