
# El lockfile se generó en macOS arm64 y no traía el binario de Rollup para Linux: construir la
# imagen de la aplicación web fallaba con «Cannot find module @rollup/rollup-linux-arm64-gnu», un
# error que culpa a npm de un problema del lockfile.
#
# Declarando las arquitecturas, `pnpm install` resuelve las variantes de todas y la imagen se
# construye igual en el Mac de quien programa, en el runner de CI y en la instancia — incluida una
# futura Graviton, que es arm64 y más barata que la x86 equivalente.
supportedArchitectures[os][]=current
supportedArchitectures[os][]=linux
supportedArchitectures[cpu][]=current
supportedArchitectures[cpu][]=x64
supportedArchitectures[cpu][]=arm64
